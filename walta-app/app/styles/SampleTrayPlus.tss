// The slot: one cell in the tray's hole grid. Its width is bound from the VM
// (half the tile's middle width); height is half the tile so the 2x2 grid packs.
"#SampleTrayPlus": {
  top: 0,
  height: "50%"
}

// The add icon, sized + positioned to match the old plus button.
".plusIcon": {
  top: "40%",
  left: "25%",
  width: "50%",
  height: "36%"
}

// A transparent full-cell overlay: the only view carrying the tap listener, so a
// tap is hit-tested onto it (not the listener-less icon beneath) on every kind.
".tapSurface": {
  width: Ti.UI.FILL,
  height: Ti.UI.FILL
}

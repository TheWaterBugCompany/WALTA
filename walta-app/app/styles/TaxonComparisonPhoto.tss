// One taxon card: the photo with its name across the bottom. Alloy resolves TSS
// per controller, so these live here rather than with the screen that hosts them.

// The mark and the photo it judges, side by side. The margins live here rather
// than on the card so the gap between two entries stays the same whether or not
// a mark is showing.
".comparisonEntry": {
	width: Ti.UI.SIZE,
	height: Ti.UI.SIZE,
	left: "6dp",
	right: "6dp"
}

// As tall as the card beside it, so the mark centres against the photo rather
// than riding the row's top edge. The height has to be repeated from
// .comparisonCard rather than taken with Ti.UI.FILL: the row that holds both is
// itself Ti.UI.SIZE, so a FILL child has nothing resolved to fill and the whole
// modal loses its height. The extra width over the icon is the gap before the
// photo.
".comparisonVerdict": {
	width: "40dp",
	height: "112dp"
}

".comparisonVerdict[if=Alloy.Globals.isHighRes]": {
	width: "52dp",
	height: "150dp"
}

".comparisonVerdict[if=Alloy.Globals.isXHighRes]": {
	width: "72dp",
	height: "210dp"
}

// No left/top: a composite parent centres a child that anchors to no edge, which
// is how the mark finds the middle of the card's height.
".comparisonVerdictIcon": {
	width: "32dp",
	height: "32dp",
	right: "8dp",
	// Titanium paints a hairline for a border colour set at zero width, so the
	// icon needs no colour rather than a hidden one — the same quirk the key's
	// hinted branches hit.
	borderColor: "transparent"
}

".comparisonVerdictIcon[if=Alloy.Globals.isHighRes]": {
	width: "44dp",
	height: "44dp"
}

".comparisonVerdictIcon[if=Alloy.Globals.isXHighRes]": {
	width: "64dp",
	height: "64dp"
}

".comparisonCard": {
	width: "150dp",
	height: "112dp"
}

".comparisonCard[if=Alloy.Globals.isHighRes]": {
	width: "200dp",
	height: "150dp"
}

".comparisonCard[if=Alloy.Globals.isXHighRes]": {
	width: "280dp",
	height: "210dp"
}

// A fixed box rather than SIZE: an ImageView asked for its intrinsic size takes
// the source's full pixel dimensions, and these photos are several thousand
// pixels wide. Scales with the screen-height buckets so the modal still fits the
// shortest landscape viewport.
".comparisonPhoto": {
	width: Ti.UI.FILL,
	height: Ti.UI.FILL
}

// Across the bottom of its own photo, as in the designs. The name is the only
// place the screen says which taxon is which, and it sits on a photograph that
// can be anything from black gravel to a white tray, so white alone disappears
// on half of them. Titanium has no text stroke, so the dark edge is a shadow —
// and the two platforms draw it differently: Android blurs it into a halo,
// while iOS ignores shadowRadius and draws a hard copy at the offset. One pixel
// of offset is what reads on both — enough to edge the glyphs on iOS, while
// staying inside Android's blur rather than doubling the text.
".comparisonCaption": {
	bottom: "6dp",
	left: "8dp",
	color: Alloy.CFG.colors.white,
	shadowColor: Alloy.CFG.colors.black,
	shadowOffset: { x: 1, y: 1 },
	shadowRadius: 2,
	font: { fontFamily: "Tahoma", fontWeight: "bold", fontStyle: "italic", fontSize: "13dp" }
}

".comparisonCaption[if=Alloy.Globals.isHighRes]": {
	font: { fontFamily: "Tahoma", fontWeight: "bold", fontStyle: "italic", fontSize: "17dp" }
}

".comparisonCaption[if=Alloy.Globals.isXHighRes]": {
	font: { fontFamily: "Tahoma", fontWeight: "bold", fontStyle: "italic", fontSize: "25dp" }
}

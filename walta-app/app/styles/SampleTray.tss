
"#content" : {
  disableBounce: true,
  canCancelEvents: true,
  backgroundColor: "#aaa",
  top: 0
}

"tray": {
  width: Ti.UI.FILL,
  height: Ti.UI.FILL
}

// The incorrect-assessment notice: a white rounded card near the top, primary
// teal text. Starts transparent (the controller fades it in on a wrong assess).
"#incorrectNotice": {
  top: "10dp",
  width: "80%",
  height: Ti.UI.SIZE,
  layout: "vertical",
  backgroundColor: Alloy.CFG.colors.white,
  borderRadius: "12dp",
  opacity: 0,
  zIndex: 100,
  viewShadowColor: "#40000000",
  viewShadowRadius: "6dp",
  viewShadowOffset: { x: 0, y: 2 }
}

"#incorrectNoticeLabel": {
  top: "14dp",
  bottom: "14dp",
  left: "16dp",
  right: "16dp",
  width: Ti.UI.FILL,
  height: Ti.UI.SIZE,
  color: Alloy.CFG.colors.primary,
  textAlign: Ti.UI.TEXT_ALIGNMENT_CENTER,
  font: { fontFamily: "Tahoma", fontSize: "15dp" }
}

"#incorrectNoticeLabel[if=Alloy.Globals.isHighRes]": {
  font: { fontFamily: "Tahoma", fontSize: "19dp" }
}

"#incorrectNoticeLabel[if=Alloy.Globals.isXHighRes]": {
  font: { fontFamily: "Tahoma", fontSize: "26dp" }
}

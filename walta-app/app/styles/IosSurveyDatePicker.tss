// As tall as the calendar in it, not as tall as the screen it opens over.
// Pinned top and bottom it was square on a phone and a tall empty strip on a
// tablet; what keeps it inside a short screen is the calendar scaling in
// fitPickerToCard, which measures against the screen rather than this card.
"#pickerWindow": {
    width: "380dp",
    height: Ti.UI.SIZE,
    borderWidth: "1dp",
    borderRadius: "12dp"
}
"#pickerCard": {
    width: Ti.UI.FILL,
    height: Ti.UI.SIZE
}
"#pickerFrame": {
    width: Ti.UI.FILL,
    height: Ti.UI.SIZE
}
"#datePicker": {
    type: Ti.UI.PICKER_TYPE_DATE
}
"#datePicker[platform=android]": {
    top: 0
}
"#datePicker[platform=ios]": {
    datePickerStyle: Ti.UI.DATE_PICKER_STYLE_INLINE,
    width: Ti.UI.FILL,
    height: Ti.UI.SIZE,
    left: "8dp",
    right: "8dp"
}
"#buttonBar": {
    width: Ti.UI.FILL,
    height: Ti.UI.SIZE,
    bottom: "10dp"
}
"#doneButton": {
    right: "12dp"
}

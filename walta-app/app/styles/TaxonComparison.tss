// Feedback on one identification from a training assessment. Wider than the
// other modals because the incorrect state sets two photos side by side and the
// reader is comparing them — that comparison is the whole point of the screen.
".comparisonWindow": {
	width: "72%",
	height: Ti.UI.SIZE,
	borderWidth: "1dp",
	borderRadius: "6dp",
	layout: "vertical"
}

// The verdict icon sits beside the message rather than above it, so the tick or
// cross reads as part of the sentence. Composite rather than horizontal: a
// horizontal row measures a FILL child against the whole row but lays it out in
// what is left of it, one line short of what the sentence wraps to.
".verdictRow": {
	top: "4dp",
	height: Ti.UI.SIZE,
	left: "6%",
	right: "6%"
}

".verdictIcon": {
	width: "32dp",
	height: "32dp",
	left: 0,
	top: "2dp",
	// Titanium paints a hairline for a border colour set at zero width, so the
	// icon needs no colour rather than a hidden one — the same quirk the key's
	// hinted branches hit.
	borderColor: "transparent"
}

".verdictIcon[if=Alloy.Globals.isHighRes]": {
	width: "44dp",
	height: "44dp"
}

".verdictIcon[if=Alloy.Globals.isXHighRes]": {
	width: "64dp",
	height: "64dp"
}

// Anchored left and right rather than given a width, so the text wraps to
// exactly the line it is laid out in. The left inset is the icon above plus an
// 8dp gap, and has to follow it through the buckets: 32+8, 44+8, 64+8.
".comparisonMessage": {
	height: Ti.UI.SIZE,
	top: 0,
	left: "40dp",
	right: 0,
	color: Alloy.CFG.colors.primary,
	textAlign: Ti.UI.TEXT_ALIGNMENT_LEFT,
	font: { fontFamily: "Tahoma", fontWeight: "bold", fontSize: "16dp" }
}

".comparisonMessage[if=Alloy.Globals.isHighRes]": {
	left: "52dp",
	font: { fontFamily: "Tahoma", fontWeight: "bold", fontSize: "22dp" }
}

".comparisonMessage[if=Alloy.Globals.isXHighRes]": {
	left: "72dp",
	font: { fontFamily: "Tahoma", fontWeight: "bold", fontSize: "32dp" }
}

// Horizontal so one card centres itself and two sit side by side without the
// screen knowing which state it is in.
".comparisonPhotos": {
	top: "10dp",
	width: Ti.UI.SIZE,
	height: Ti.UI.SIZE,
	layout: "horizontal",
	// Defaults to true, which wraps the second card onto a row of its own inside a
	// SIZE-wide container — the two must stay side by side to be compared.
	horizontalWrap: false
}

// No left/right: setting both against a SIZE width over-constrains the button
// (it pins to the left and truncates its title). A vertical layout centres its
// children on its own.
// A View rather than a Button: Titanium sizes a Button to its title and ignores
// padding on iOS, so the border sat on the glyphs. Chrome here, text in
// .comparisonActionLabel, whose margins are the padding — the NavButton idiom.
".comparisonAction": {
	top: "12dp",
	bottom: "12dp",
	width: Ti.UI.SIZE,
	height: "36dp",
	backgroundColor: Alloy.CFG.colors.white,
	borderColor: Alloy.CFG.colors.primary,
	borderWidth: "1dp",
	borderRadius: "4dp"
}

// The left/right margins are what hold the border clear of the title. Carries its
// own font rather than .actionButton, whose 100dp width truncates this screen's
// long title, so it still reads as one of the set.
".comparisonActionLabel": {
	width: Ti.UI.SIZE,
	height: Ti.UI.SIZE,
	left: "16dp",
	right: "16dp",
	color: Alloy.CFG.colors.primary,
	textAlign: Ti.UI.TEXT_ALIGNMENT_CENTER,
	font: { fontFamily: "Tahoma", fontWeight: "bold", fontSize: "15dp" }
}

".comparisonAction[if=Alloy.Globals.isHighRes]": {
	height: "48dp"
}

".comparisonActionLabel[if=Alloy.Globals.isHighRes]": {
	left: "22dp",
	right: "22dp",
	font: { fontFamily: "Tahoma", fontWeight: "bold", fontSize: "20dp" }
}

".comparisonAction[if=Alloy.Globals.isXHighRes]": {
	height: "64dp"
}

".comparisonActionLabel[if=Alloy.Globals.isXHighRes]": {
	left: "30dp",
	right: "30dp",
	font: { fontFamily: "Tahoma", fontWeight: "bold", fontSize: "28dp" }
}

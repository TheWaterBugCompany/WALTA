// Feedback on one identification from a training assessment.
//
// The width is derived from what it has to hold rather than taken as a share of
// the screen: the incorrect state sets two photo entries side by side, and those
// are sized in dp per resolution bucket. A percentage looked fine on a wide
// phone and clipped the second photo on a narrow one, because the bucket says
// nothing about how wide the screen is. So the modal is two entries wide plus
// the padding — .comparisonEntry's 6dp margins either side of a verdict box and
// a card, which comes to 202 / 264 / 364dp an entry through the buckets. The
// rest is the breathing room either side: a card's outer edge sits 36 / 52 /
// 60dp from the modal's, so two entries plus twice that is the width.
".comparisonWindow": {
	width: "464dp",
	height: Ti.UI.SIZE,
	borderWidth: "1dp",
	borderRadius: "6dp",
	layout: "vertical"
}

".comparisonWindow[if=Alloy.Globals.isHighRes]": {
	width: "620dp"
}

".comparisonWindow[if=Alloy.Globals.isXHighRes]": {
	width: "836dp"
}

// One gap over and over — above the heading, under it, under the photos and
// under the action — so the modal reads as evenly spaced top to bottom.
//
// The two margins above the photos are short of that gap by the slack the ✕
// leaves around the heading: the titlebar is as tall as the button (taller than
// the text, which centres itself in it), and that extra shows up as white space
// on both sides of the heading. Measured at 13dp a side in the high-res bucket,
// so 20dp of gap is a 7dp margin. In the extra-high bucket the heading is taller
// than the button and there is no slack to take off.
".comparisonTitlebar": {
	top: "9dp"
}

".comparisonTitlebar[if=Alloy.Globals.isHighRes]": {
	top: "7dp"
}

".comparisonTitlebar[if=Alloy.Globals.isXHighRes]": {
	top: "28dp"
}

// No top or bottom: a composite parent centres a child that anchors to neither,
// which is what levels the heading with the ✕ beside it. The left and right
// margins are the ✕'s own width plus a gap, kept equal so the heading stays
// centred in the modal while never running under the button.
".comparisonMessage": {
	height: Ti.UI.SIZE,
	left: "36dp",
	right: "36dp",
	color: Alloy.CFG.colors.primary,
	textAlign: Ti.UI.TEXT_ALIGNMENT_CENTER,
	font: { fontFamily: "Tahoma", fontWeight: "bold", fontSize: "16dp" }
}

".comparisonMessage[if=Alloy.Globals.isHighRes]": {
	left: "60dp",
	right: "60dp",
	font: { fontFamily: "Tahoma", fontWeight: "bold", fontSize: "22dp" }
}

".comparisonMessage[if=Alloy.Globals.isXHighRes]": {
	font: { fontFamily: "Tahoma", fontWeight: "bold", fontSize: "32dp" }
}

// Horizontal so one card centres itself and two sit side by side without the
// screen knowing which state it is in.
".comparisonPhotos": {
	top: "9dp",
	width: Ti.UI.SIZE,
	height: Ti.UI.SIZE,
	layout: "horizontal",
	// Defaults to true, which wraps the second card onto a row of its own inside a
	// SIZE-wide container — the two must stay side by side to be compared.
	horizontalWrap: false
}

// No left/right: setting both against a SIZE width over-constrains the button
// (it pins to the left and truncates its title). A vertical layout centres its
// children on its own.
// A View rather than a Button: Titanium sizes a Button to its title and ignores
// padding on iOS, so the border sat on the glyphs. Chrome here, text in
// .comparisonActionLabel, whose margins are the padding — the NavButton idiom.
".comparisonAction": {
	top: "14dp",
	bottom: "14dp",
	width: Ti.UI.SIZE,
	height: "36dp",
	backgroundColor: Alloy.CFG.colors.white,
	borderColor: Alloy.CFG.colors.primary,
	borderWidth: "1dp",
	borderRadius: "4dp"
}

// The left/right margins are what hold the border clear of the title. Carries its
// own font rather than .actionButton, whose 100dp width truncates this screen's
// long title, so it still reads as one of the set.
".comparisonActionLabel": {
	width: Ti.UI.SIZE,
	height: Ti.UI.SIZE,
	left: "16dp",
	right: "16dp",
	color: Alloy.CFG.colors.primary,
	textAlign: Ti.UI.TEXT_ALIGNMENT_CENTER,
	font: { fontFamily: "Tahoma", fontWeight: "bold", fontSize: "15dp" }
}

".comparisonPhotos[if=Alloy.Globals.isHighRes]": {
	top: "7dp"
}

".comparisonPhotos[if=Alloy.Globals.isXHighRes]": {
	top: "28dp"
}

".comparisonAction[if=Alloy.Globals.isHighRes]": {
	top: "20dp",
	bottom: "20dp",
	height: "48dp"
}

".comparisonActionLabel[if=Alloy.Globals.isHighRes]": {
	left: "22dp",
	right: "22dp",
	font: { fontFamily: "Tahoma", fontWeight: "bold", fontSize: "20dp" }
}

".comparisonAction[if=Alloy.Globals.isXHighRes]": {
	top: "28dp",
	bottom: "28dp",
	height: "64dp"
}

".comparisonActionLabel[if=Alloy.Globals.isXHighRes]": {
	left: "30dp",
	right: "30dp",
	font: { fontFamily: "Tahoma", fontWeight: "bold", fontSize: "28dp" }
}

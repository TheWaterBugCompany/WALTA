// One page of the photo pager. The platform split is the zoom mechanism and
// nothing else: iOS zooms by scrolling a scaled surface, Android zooms inside the
// ImageView, so the wrapper is inert there rather than absent — one structure
// keeps the bindings addressing one set of ids.
// contentWidth/contentHeight are not decoration: inside a ScrollView, a FILL
// child resolves against the *content* size, and with no content size declared
// the content takes its measure from the image's own pixels — so the page laid
// itself out at 1024x683 and the window clipped it. Pinning the content to the
// viewport is what gives FILL a screen to fill.
".galleryZoom": {
	width: Ti.UI.FILL,
	height: Ti.UI.FILL,
	contentWidth: Ti.UI.FILL,
	contentHeight: Ti.UI.FILL
}

".galleryZoom[platform=ios]": {
	disableBounce: true,
	minZoomScale: 1.0,
	maxZoomScale: 10.0
}

// Android pinch-zooms in the ImageView, so the wrapper must not take the gesture
// or pan the page out from under the pager.
".galleryZoom[platform=android]": {
	scrollingEnabled: false
}

".galleryFrame": {
	width: Ti.UI.FILL,
	height: Ti.UI.FILL
}

// No width: with a number for the height, Titanium works the width out from the
// photo's own proportions. Setting both stretches it.
".galleryPhoto": {
}

".galleryPhoto[platform=android]": {
	enableZoomControls: true
}

// White on an arbitrary photo needs the shadow to stay legible — the photo behind
// it can be any colour.
".galleryTaxonLabel": {
	top: "50dp",
	width: Ti.UI.SIZE,
	height: Ti.UI.SIZE,
	color: "white",
	shadowColor: Alloy.CFG.colors.black,
	shadowOffset: { x: 5, y: 5 },
	shadowRadius: "3dp",
	font: { fontSize: "20dp" }
}

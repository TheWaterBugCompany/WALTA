
".container" : {
  top: '1%',
  width: "100%",
  height: "100%",
  backgroundColor: 'white',
  layout: 'vertical'
}

"#header": {
  width: Ti.UI.FILL,
  height: "8.5%"
}

"#questions": {
  width: Ti.UI.FILL,
  height: Ti.UI.FILL,
  layout: "vertical"
}

// The tap target spans the header's left edge — the reach the old hit-test
// geometry gave it, without measuring the click.
"#upButton": { 
  horizontalWrap: false,
  width: "20%",
  height: Ti.UI.FILL,
  left: "6dp",
  top: "6dp"
}

"#upButtonImage": {
  image: "/images/icon-go-up.png", 
  left: 0,
  width: "20dp",
  height: "20dp"
}
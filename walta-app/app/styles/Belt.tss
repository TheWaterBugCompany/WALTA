// A belt drawn flat: a bar outlined in black, with the tip banded across it
// near the right-hand end. The tip runs flush to the bar's edges so the two
// outlines meet and it reads as a band across the belt rather than a block
// sitting on it — the same construction as the home screen's corner ribbon.
//
// The belt fills the holder the screen mounts it into, and so it is the screen
// that says how thick a belt is drawn there. A holder sized to its contents
// instead would never show one: it measures itself before the belt is mounted,
// and adding a child later doesn't make it measure again.
".belt": {
	width: "100%",
	height: "100%",
	borderWidth: "2dp",
	borderColor: Alloy.CFG.colors.black
}

".beltTip": {
	width: "7%",
	top: "0dp",
	bottom: "0dp",
	right: "8%",
	visible: false,
	borderWidth: "2dp",
	borderColor: Alloy.CFG.colors.black
}

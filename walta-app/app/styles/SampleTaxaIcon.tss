"#abundance": {
  right: "2dp",
  bottom: "6dp",
  color: Alloy.CFG.colors.white,
  backgroundColor: "#f00",
  borderColor: "#f00",
  width: "35dp",
  height: "16dp",
  textAlign: Ti.UI.TEXT_ALIGNMENT_CENTER,
  borderRadius: "8dp",
  font: { fontSize: "10dp" }
}

"#abundance[if=Alloy.Globals.isHighRes]": {
  font: { fontSize: "12dp" },
  width: "32dp",
  height: "18dp"
}

"#abundance[if=Alloy.Globals.isXHighRes]": {
  font: { fontSize: "24dp" },
  width: "56dp",
  height: "32dp",
  borderRadius: "16dp"
}

// The slot: one cell in the tray's hole grid. Its width is bound from the VM
// (half the tile's middle width); height is half the tile so the 2x2 grid packs.
"#SampleTaxaIcon": {
  top: 0,
  height: "50%"
}

".padIcon": {
  width: "80%",
  height: "80%"
}

// The training tray's cell number: white numerals outlined against the white
// tray by a primary-coloured shadow. Font size is bound from the view-model so
// it scales with the cell.
".cellNumber": {
  color: Alloy.CFG.colors.white,
  shadowColor: Alloy.CFG.colors.primary,
  shadowOffset: { x: 0, y: 0 },
  shadowRadius: 3,
  visible: false
}

// The tick/cross overlay: a square badge inset into the cell's lower-left, hidden
// until the tray is assessed. Its square size (dp) is bound from the cell
// view-model so it scales with the cell; left/bottom inset it off the corner.
// Image + visibility are also bound from the view-model.
".verdict": {
  left: "12%",
  bottom: "12%",
  visible: false
}

// A transparent full-cell overlay: the only view carrying the tap listener, so a
// tap is hit-tested onto it (not the listener-less icon beneath) on every kind.
".tapSurface": {
  width: Ti.UI.FILL,
  height: Ti.UI.FILL
}

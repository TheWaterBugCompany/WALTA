
".window": {
  width: "96%",
  height: "96%"
}

// Sized by what it holds. The buttons scale with the screen band — a tablet
// gives them a 34dp font — and a bar fixed at phone proportions either clips
// them or leaves them squeezed against each other.
"#buttonBar": {
  horizontalWrap: false,
  bottom: "1%",
  right: 0,
  width: Ti.UI.SIZE,
  height: Ti.UI.SIZE
}

"#locateButton": {
  borderColor: "transparent",
  borderWidth: 0, 
  backgroundColor: "transparent",
  width: Ti.UI.SIZE,
  height: Ti.UI.SIZE
}


"#locateButtonIcon": {
  backgroundColor: "transparent",
  image: "/images/locate-icon.png",
  width: "30dp",
  height: "30dp"
}

// No width here: these are .actionButton, which sizes itself for the band, and
// a width set over it is a phone's width applied to every screen — on a tablet
// the title no longer fits and renders as an ellipsis.
"#cancelButton": {
  backgroundColor: "#ef8b8b",
  left: "5%"
}

"#saveButton": {
  backgroundColor: "#92d050",
  left: "5%"
}
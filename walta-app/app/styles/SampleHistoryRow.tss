".column": {
    left: "1%",
    right: "1%",
    height: "45dp",
    textAlign: Ti.UI.TEXT_ALIGNMENT_LEFT,
    font: {
        fontFamily: "Tahoma",
        fontWeight: "bold",
        fontSize: "14dp"
    }
}
".row": {
    layout: "horizontal",
    horizontalWrap: false
}
".dateCompletedColumn": {
    width: "180dp",
    height: Ti.UI.SIZE
}
".idColumn": {
    width: "40dp"
}
".boolColumn": {
    width: "60dp"
}
".waterbodyName": {
    textAlign: Ti.UI.TEXT_ALIGNMENT_LEFT,
    width: "35%"
}

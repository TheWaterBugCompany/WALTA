"#cell": {
  top: 0
}

".trayBackground": {
  width: Ti.UI.FILL,
  height: Ti.UI.FILL
}

// The hole grid. Its layout (horizontal for a tile, vertical for the endcap) and
// its width/left inset (full for a tile, off the endcap's lip) are bound from the
// tile VM — the one view difference between the two shapes.
".holes": {
  height: Ti.UI.FILL
}

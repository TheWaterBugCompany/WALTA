".successWindow": {
	width: "65%",
	height: Ti.UI.SIZE,
	borderWidth: "1dp",
	borderRadius: "6dp",
	layout: "vertical"
}

// The congratulation reads as one line of thought: the confetti to the left of
// the sentence it belongs to, rather than stacked above it.
"#successHeader": {
	width: Ti.UI.FILL,
	height: Ti.UI.SIZE,
	top: "8dp"
}

"#successMessage": {
	// An explicit width (not left/right margins alone): Android otherwise
	// measures the label at a width it is not laid out in, wraps to fewer lines,
	// and clips.
	width: "62%",
	height: Ti.UI.SIZE,
	left: "4%",
	color: Alloy.CFG.colors.primary,
	textAlign: Ti.UI.TEXT_ALIGNMENT_LEFT,
	font: { fontFamily: "Tahoma", fontSize: "20dp" }
}

"#successMessage[if=Alloy.Globals.isHighRes]": {
	font: { fontFamily: "Tahoma", fontSize: "26dp" }
}

"#successMessage[if=Alloy.Globals.isXHighRes]": {
	font: { fontFamily: "Tahoma", fontSize: "38dp" }
}

// Sized by height (width SIZE keeps the aspect) so the whole modal — titlebar,
// message, graphic, belt, button — fits the shortest landscape viewport without
// scrolling. Scales up with the screen-height buckets; the base serves the
// smallest screens.
".successGraphic": {
	left: "8%",
	width: Ti.UI.SIZE,
	height: "44dp"
}

".successGraphic[if=Alloy.Globals.isHighRes]": {
	height: "64dp"
}

".successGraphic[if=Alloy.Globals.isXHighRes]": {
	height: "104dp"
}

// The belt and the sentence that introduces it share a left edge, so the
// sentence reads as a label on the belt below it.
".beltMessage": {
	width: "84%",
	height: Ti.UI.SIZE,
	left: "8%",
	top: "16dp",
	visible: false,
	color: Alloy.CFG.colors.primary,
	textAlign: Ti.UI.TEXT_ALIGNMENT_LEFT,
	font: { fontFamily: "Tahoma", fontSize: "20dp" }
}

".beltMessage[if=Alloy.Globals.isHighRes]": {
	font: { fontFamily: "Tahoma", fontSize: "26dp" }
}

".beltMessage[if=Alloy.Globals.isXHighRes]": {
	font: { fontFamily: "Tahoma", fontSize: "38dp" }
}

// An explicit height, not Ti.UI.SIZE: the belt is mounted into this holder
// after it has laid out, and a holder sized to its contents never measures
// again — so it would stay flat and the belt would never appear.
".beltHolder": {
	width: "84%",
	height: "32dp",
	left: "8%",
	top: "10dp",
	visible: false
}

".beltHolder[if=Alloy.Globals.isHighRes]": {
	height: "44dp"
}

".beltHolder[if=Alloy.Globals.isXHighRes]": {
	height: "64dp"
}

".finishButton": {
	top: "16dp",
	bottom: "12dp",
	color: Alloy.CFG.colors.primary,
	backgroundColor: Alloy.CFG.colors.white,
	borderColor: Alloy.CFG.colors.primary,
	borderWidth: "1dp"
}

"#content": {
    top: "10dp",
    left: "10dp",
    right: "10dp",
    layout:"vertical"
}
"#surveyDate": {
    height: "44dp",
    layout: "horizontal",
    top: "20dp"
}
"#surveyDateTitle": {
    width: Ti.UI.SIZE,
    height: "36dp",
    verticalAlign: Ti.UI.TEXT_VERTICAL_ALIGNMENT_CENTER,
    left: 0
}
"#surveyDateField": {
    layout: "horizontal",
    left: "12dp",
    width: Ti.UI.SIZE,
    height: "36dp",
    borderColor: Alloy.CFG.colors.primary,
    borderWidth: "1dp",
    borderRadius: "6dp"
}
"#surveyDateValue": {
    left: "12dp",
    width: Ti.UI.SIZE,
    height: "36dp",
    verticalAlign: Ti.UI.TEXT_VERTICAL_ALIGNMENT_CENTER
}
"#surveyDateIcon": {
    left: "8dp",
    right: "10dp",
    top: "9dp",
    width: "18dp",
    height: "18dp",
    tintColor: Alloy.CFG.colors.primary
}
"#partial": {
    height: "50dp"
}
"#notes": {
    top: "10dp",
    layout: "vertical",
    height: Ti.UI.FILL
}
"#notesTextField": {
    fullscreen: false,
    backgroundColor: "transparent",
    borderColor: Alloy.CFG.colors.primary,
    color: Alloy.CFG.colors.primary,
    top: "10dp",
    borderWidth: "1dp",
    left: "16dp",
    right: "16dp",
    bottom: "16dp",
    height: Ti.UI.FILL,
    width: Ti.UI.FILL,
    font: {
        fontFamily: "Tahoma",
        fontSize: "16dp"
    },
    hintTextColor: "#c9cacb"
}
"#notesTextField[if=Alloy.Globals.isHighRes]": {
   font: {
    fontSize: "18dp"
  }
}

"#notesTextField[if=Alloy.Globals.isXHighRes]": {
   font: {
    fontSize: "32dp"
  }
}

"#partialLabel": {
    left: "10%",
    height: Ti.UI.SIZE,
    width: "90%"
}
".checkbox": {
    tintColor: "#b4d2d9",
    left: 0
}

"#nextButton": {
    right: "1%",
    bottom: "18%"
}
".academyWindow": {
	width: "65%",
	height: Ti.UI.SIZE,
	layout: "vertical"
}

"#academyTitle": {
	top: "12dp",
	height: Ti.UI.SIZE,
	font: { fontFamily: "Tahoma", fontWeight: "bold", fontSize: "22dp" }
}

// Each belt is introduced by the line above it, so the two share a left edge
// and the caption reads as a label on the bar below it.
".beltCaption": {
	top: "16dp",
	// An explicit width (not left/right margins alone): Android otherwise
	// measures the label's height at a width it is not laid out in, wraps to
	// fewer lines, and clips.
	width: "84%",
	height: Ti.UI.SIZE,
	left: "8%",
	color: Alloy.CFG.colors.primary,
	textAlign: Ti.UI.TEXT_ALIGNMENT_LEFT,
	font: { fontFamily: "Tahoma", fontSize: "15dp" }
}

".beltCaption[if=Alloy.Globals.isHighRes]": {
	font: { fontFamily: "Tahoma", fontSize: "19dp" }
}

".beltCaption[if=Alloy.Globals.isXHighRes]": {
	font: { fontFamily: "Tahoma", fontSize: "28dp" }
}

// An explicit height, not Ti.UI.SIZE: the belt is mounted into this holder
// after it has laid out, and a holder sized to its contents never measures
// again — so it would stay flat and the belt would never appear.
".academyBelt": {
	width: "84%",
	height: "32dp",
	left: "8%",
	top: "8dp"
}

".academyBelt[if=Alloy.Globals.isHighRes]": {
	height: "44dp"
}

".academyBelt[if=Alloy.Globals.isXHighRes]": {
	height: "64dp"
}

".academyIntro": {
	top: "20dp",
	width: "84%",
	height: Ti.UI.SIZE,
	left: "8%",
	color: Alloy.CFG.colors.primary,
	textAlign: Ti.UI.TEXT_ALIGNMENT_LEFT,
	font: { fontFamily: "Tahoma", fontSize: "15dp" }
}

".academyIntro[if=Alloy.Globals.isHighRes]": {
	font: { fontFamily: "Tahoma", fontSize: "19dp" }
}

".academyIntro[if=Alloy.Globals.isXHighRes]": {
	font: { fontFamily: "Tahoma", fontSize: "28dp" }
}

".academyButtons": {
	top: "20dp",
	bottom: "16dp",
	width: Ti.UI.SIZE,
	height: Ti.UI.SIZE
}

"#cancelButton": {
	right: "12dp",
	color: Alloy.CFG.colors.primary,
	backgroundColor: Alloy.CFG.colors.white,
	borderColor: Alloy.CFG.colors.primary,
	borderWidth: "1dp"
}

"#startButton": {
	left: "12dp",
	color: Alloy.CFG.colors.white,
	backgroundColor: Alloy.CFG.colors.success,
	// Newer Android keeps a disabled Ti.UI.Button on its enabled backgroundColor
	// (shows green) instead of the grey the VM binds — so an unwritten course
	// reads as a startable one. An explicit disabled background fixes the paint.
	backgroundDisabledColor: Alloy.CFG.colors.disabled,
	borderColor: Alloy.CFG.colors.success
}

".academyWindow": {
	width: "56%",
	height: Ti.UI.SIZE,
	layout: "vertical"
}

"#academyTitle": {
	top: "12dp",
	height: Ti.UI.SIZE,
	font: { fontFamily: "Tahoma", fontWeight: "bold", fontSize: "22dp" }
}

".academyIntro": {
	top: "16dp",
	// FILL + SIZE (not left/right margins alone): Android otherwise measures the
	// label's height at an unconstrained width, wraps to fewer lines, and clips.
	width: Ti.UI.FILL,
	height: Ti.UI.SIZE,
	left: "6%",
	right: "6%",
	color: Alloy.CFG.colors.primary,
	font: { fontFamily: "Tahoma", fontSize: "13dp" }
}

".academyPrompt": {
	top: "16dp",
	width: Ti.UI.FILL,
	height: Ti.UI.SIZE,
	left: "6%",
	right: "6%",
	color: Alloy.CFG.colors.primary,
	font: { fontFamily: "Tahoma", fontWeight: "bold", fontSize: "13dp" }
}

".codeRow": {
	top: "16dp",
	width: Ti.UI.SIZE,
	height: Ti.UI.SIZE
}

".codeBox": {
	width: "48dp",
	height: "48dp",
	left: "6dp",
	right: "6dp",
	backgroundColor: Alloy.CFG.colors.white,
	borderColor: Alloy.CFG.colors.primary,
	borderWidth: "2dp",
	borderRadius: "8dp",
	color: Alloy.CFG.colors.primary,
	textAlign: Ti.UI.TEXT_ALIGNMENT_CENTER,
	font: { fontFamily: "Tahoma", fontWeight: "bold", fontSize: "22dp" }
}

".codeBox[if=Alloy.Globals.isHighRes]": {
	width: "64dp",
	height: "64dp",
	font: { fontSize: "28dp" }
}

".codeBox[if=Alloy.Globals.isXHighRes]": {
	width: "96dp",
	height: "96dp",
	font: { fontSize: "40dp" }
}

".academyButtons": {
	top: "24dp",
	bottom: "20dp",
	width: Ti.UI.SIZE,
	height: Ti.UI.SIZE
}

"#cancelButton": {
	right: "12dp",
	color: Alloy.CFG.colors.primary,
	backgroundColor: Alloy.CFG.colors.white,
	borderColor: Alloy.CFG.colors.primary,
	borderWidth: "1dp"
}

"#startButton": {
	left: "12dp",
	color: Alloy.CFG.colors.white,
	backgroundColor: Alloy.CFG.colors.success,
	borderColor: Alloy.CFG.colors.success
}

// The digit picker: a full-screen dim over the modal with a centered key grid.
"#digitPicker": {
	width: Ti.UI.FILL,
	height: Ti.UI.FILL,
	backgroundColor: "#80000000",
	zIndex: 200
}

".digitPickerCard": {
	width: Ti.UI.SIZE,
	height: Ti.UI.SIZE,
	backgroundColor: Alloy.CFG.colors.white,
	borderColor: Alloy.CFG.colors.primary,
	borderWidth: "2dp",
	borderRadius: "12dp",
	padding: { top: "8dp", bottom: "8dp", left: "8dp", right: "8dp" }
}

".keypadRow": {
	width: Ti.UI.SIZE,
	height: Ti.UI.SIZE
}

".keypadKey": {
	width: "52dp",
	height: "52dp",
	left: "6dp",
	right: "6dp",
	top: "6dp",
	bottom: "6dp",
	color: Alloy.CFG.colors.primary,
	backgroundColor: Alloy.CFG.colors.white,
	borderColor: Alloy.CFG.colors.primary,
	borderWidth: "2dp",
	borderRadius: "8dp",
	font: { fontFamily: "Tahoma", fontWeight: "bold", fontSize: "24dp" }
}

".keypadKey[if=Alloy.Globals.isHighRes]": {
	width: "64dp",
	height: "64dp",
	font: { fontSize: "28dp" }
}

".keypadKey[if=Alloy.Globals.isXHighRes]": {
	width: "96dp",
	height: "96dp",
	font: { fontSize: "40dp" }
}

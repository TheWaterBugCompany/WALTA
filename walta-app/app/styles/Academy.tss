".academyWindow": {
	width: "72%",
	height: Ti.UI.SIZE,
	layout: "vertical"
}

"#academyTitle": {
	top: "12dp",
	height: Ti.UI.SIZE,
	font: { fontFamily: "Tahoma", fontWeight: "bold", fontSize: "26dp" }
}

".academyIntro": {
	top: "16dp",
	left: "6%",
	right: "6%",
	color: Alloy.CFG.colors.primary,
	font: { fontFamily: "Tahoma", fontSize: "13dp" }
}

".academyPrompt": {
	top: "16dp",
	left: "6%",
	right: "6%",
	color: Alloy.CFG.colors.primary,
	font: { fontFamily: "Tahoma", fontWeight: "bold", fontSize: "13dp" }
}

".codeRow": {
	top: "16dp",
	width: Ti.UI.SIZE,
	height: Ti.UI.SIZE
}

".codeBox": {
	width: "48dp",
	height: "48dp",
	left: "6dp",
	right: "6dp",
	borderColor: Alloy.CFG.colors.primary,
	borderWidth: "2dp",
	borderRadius: "8dp",
	color: Alloy.CFG.colors.primary,
	textAlign: Ti.UI.TEXT_ALIGNMENT_CENTER,
	maxLength: 1,
	keyboardType: Ti.UI.KEYBOARD_TYPE_NUMBER_PAD,
	font: { fontFamily: "Tahoma", fontWeight: "bold", fontSize: "22dp" }
}

".codeBox[if=Alloy.Globals.isHighRes]": {
	width: "64dp",
	height: "64dp",
	font: { fontSize: "28dp" }
}

".codeBox[if=Alloy.Globals.isXHighRes]": {
	width: "96dp",
	height: "96dp",
	font: { fontSize: "40dp" }
}

".academyButtons": {
	top: "24dp",
	bottom: "20dp",
	width: Ti.UI.SIZE,
	height: Ti.UI.SIZE
}

"#cancelButton": {
	right: "12dp",
	color: Alloy.CFG.colors.primary,
	backgroundColor: Alloy.CFG.colors.white,
	borderColor: Alloy.CFG.colors.primary,
	borderWidth: "1dp"
}

"#startButton": {
	left: "12dp",
	color: Alloy.CFG.colors.white,
	backgroundColor: Alloy.CFG.colors.success,
	borderColor: Alloy.CFG.colors.success
}

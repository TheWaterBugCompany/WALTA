// The modal sits in a ScrollView so iOS can slide it clear of the keyboard, the
// same regime the entry screens get from applyKeyboardTweaks. contentHeight FILL
// keeps the resting layout centred rather than pinned to the top of the scroll.
".entryScroll": {
	width: Ti.UI.FILL,
	height: Ti.UI.FILL,
	contentWidth: Ti.UI.FILL,
	contentHeight: Ti.UI.FILL,
	horizontalBounce: false,
	showHorizontalScrollIndicator: false,
	showVerticalScrollIndicator: false
}

".academyWindow": {
	width: "56%",
	height: Ti.UI.SIZE,
	layout: "vertical"
}

"#academyTitle": {
	top: "12dp",
	height: Ti.UI.SIZE,
	font: { fontFamily: "Tahoma", fontWeight: "bold", fontSize: "22dp" }
}

".academyIntro": {
	top: "16dp",
	// FILL + SIZE (not left/right margins alone): Android otherwise measures the
	// label's height at an unconstrained width, wraps to fewer lines, and clips.
	width: Ti.UI.FILL,
	height: Ti.UI.SIZE,
	left: "6%",
	right: "6%",
	color: Alloy.CFG.colors.primary,
	font: { fontFamily: "Tahoma", fontSize: "13dp" }
}

".academyPrompt": {
	top: "16dp",
	width: Ti.UI.FILL,
	height: Ti.UI.SIZE,
	left: "6%",
	right: "6%",
	color: Alloy.CFG.colors.primary,
	font: { fontFamily: "Tahoma", fontWeight: "bold", fontSize: "13dp" }
}

".codeRow": {
	top: "16dp",
	width: Ti.UI.SIZE,
	height: Ti.UI.SIZE
}

".codeBox": {
	width: "48dp",
	height: "48dp",
	left: "6dp",
	right: "6dp",
	backgroundColor: Alloy.CFG.colors.white,
	borderColor: Alloy.CFG.colors.primary,
	borderWidth: "2dp",
	borderRadius: "8dp",
	color: Alloy.CFG.colors.primary,
	textAlign: Ti.UI.TEXT_ALIGNMENT_CENTER,
	maxLength: 1,
	keyboardType: Ti.UI.KEYBOARD_TYPE_NUMBER_PAD,
	returnKeyType: Ti.UI.RETURNKEY_DONE,
	// Every other entry field in the app gets this from the shared .textField
	// class; the code boxes carry their own layout, so they need it directly.
	// Without it Android's landscape IME goes to "extract mode" and replaces
	// the whole app with its own full-screen editor.
	fullscreen: false,
	font: { fontFamily: "Tahoma", fontWeight: "bold", fontSize: "22dp" }
}

".codeBox[if=Alloy.Globals.isHighRes]": {
	width: "64dp",
	height: "64dp",
	font: { fontSize: "28dp" }
}

".codeBox[if=Alloy.Globals.isXHighRes]": {
	width: "96dp",
	height: "96dp",
	font: { fontSize: "40dp" }
}

".academyButtons": {
	top: "24dp",
	bottom: "20dp",
	width: Ti.UI.SIZE,
	height: Ti.UI.SIZE
}

"#cancelButton": {
	right: "12dp",
	color: Alloy.CFG.colors.primary,
	backgroundColor: Alloy.CFG.colors.white,
	borderColor: Alloy.CFG.colors.primary,
	borderWidth: "1dp"
}

"#startButton": {
	left: "12dp",
	color: Alloy.CFG.colors.white,
	backgroundColor: Alloy.CFG.colors.success,
	// Newer Android keeps a disabled Ti.UI.Button on its enabled backgroundColor
	// (shows green) instead of the grey the VM binds — so an invalid code reads
	// as a valid, tappable one. An explicit disabled background fixes the paint.
	backgroundDisabledColor: Alloy.CFG.colors.disabled,
	borderColor: Alloy.CFG.colors.success
}

".academyWindow": {
	width: "85%",
	height: Ti.UI.SIZE,
	layout: "vertical"
}

"#academyTitle": {
	top: "12dp",
	height: Ti.UI.SIZE,
	font: { fontFamily: "Tahoma", fontWeight: "bold", fontSize: "22dp" }
}

// Each belt is introduced by the line above it, so the two share a left edge
// and the caption reads as a label on the bar below it.
".beltCaption": {
	top: "16dp",
	// An explicit width (not left/right margins alone): Android otherwise
	// measures the label's height at a width it is not laid out in, wraps to
	// fewer lines, and clips.
	width: "84%",
	height: Ti.UI.SIZE,
	left: "8%",
	color: Alloy.CFG.colors.primary,
	textAlign: Ti.UI.TEXT_ALIGNMENT_LEFT,
	font: { fontFamily: "Tahoma", fontSize: "15dp" }
}

".beltCaption[if=Alloy.Globals.isHighRes]": {
	font: { fontFamily: "Tahoma", fontSize: "19dp" }
}

".beltCaption[if=Alloy.Globals.isXHighRes]": {
	font: { fontFamily: "Tahoma", fontSize: "28dp" }
}

// A short screen cannot take the high-res sizes: the modal is only ~336dp of
// usable height there, and the buttons are the last thing in a vertical layout,
// so they are what Titanium squeezes away. Smaller words, full-size belts.
".beltCaption[if=Alloy.Globals.isShort]": {
	font: { fontFamily: "Tahoma", fontSize: "15dp" }
}

// The caption sits directly under the title, so it needs less air above it
// than the captions that separate one belt group from the next.
"#currentMessage": {
	top: "8dp"
}

// The holder gives the belt its thickness — the belt itself fills whatever it
// is mounted into.
".academyBelt": {
	width: "84%",
	height: "32dp",
	left: "8%",
	top: "8dp"
}

".academyBelt[if=Alloy.Globals.isHighRes]": {
	height: "44dp"
}

".academyBelt[if=Alloy.Globals.isXHighRes]": {
	height: "64dp"
}

".academyIntro": {
	top: "20dp",
	width: "84%",
	height: Ti.UI.SIZE,
	left: "8%",
	color: Alloy.CFG.colors.primary,
	textAlign: Ti.UI.TEXT_ALIGNMENT_LEFT,
	font: { fontFamily: "Tahoma", fontSize: "15dp" }
}

".academyIntro[if=Alloy.Globals.isHighRes]": {
	font: { fontFamily: "Tahoma", fontSize: "19dp" }
}

".academyIntro[if=Alloy.Globals.isXHighRes]": {
	font: { fontFamily: "Tahoma", fontSize: "28dp" }
}

".academyButtons": {
	top: "20dp",
	bottom: "16dp",
	width: Ti.UI.SIZE,
	height: Ti.UI.SIZE
}

"#cancelButton": {
	right: "12dp",
	color: Alloy.CFG.colors.primary,
	backgroundColor: Alloy.CFG.colors.white,
	borderColor: Alloy.CFG.colors.primary,
	borderWidth: "1dp"
}

"#startButton": {
	left: "12dp",
	color: Alloy.CFG.colors.white,
	backgroundColor: Alloy.CFG.colors.success,
	// Newer Android keeps a disabled Ti.UI.Button on its enabled backgroundColor
	// (shows green) instead of the grey the VM binds — so an unwritten course
	// reads as a startable one. An explicit disabled background fixes the paint.
	backgroundDisabledColor: Alloy.CFG.colors.disabled,
	borderColor: Alloy.CFG.colors.success
}

// The belt keeps the thickness it has on a phone at the roomy end of the band
// only if there is room for it. There isn't: the shortest screen the app runs
// on is ~320dp, and a belt that costs the buttons their place is worse than a
// thinner belt.
".academyBelt[if=Alloy.Globals.isShort]": {
	height: "32dp"
}

".academyIntro[if=Alloy.Globals.isShort]": {
	top: "12dp",
	font: { fontFamily: "Tahoma", fontSize: "15dp" }
}

".academyButtons[if=Alloy.Globals.isShort]": {
	top: "12dp"
}

// The modal sits in a ScrollView so iOS can slide it clear of the keyboard —
// without it the keyboard covers the two buttons below the password field.
// contentHeight FILL keeps the resting layout centred rather than pinned to the
// top of the scroll.
".entryScroll": {
	width: Ti.UI.FILL,
	height: Ti.UI.FILL,
	contentWidth: Ti.UI.FILL,
	contentHeight: Ti.UI.FILL,
	horizontalBounce: false,
	showHorizontalScrollIndicator: false,
	showVerticalScrollIndicator: false
}

".deleteWindow": {
	width: "72%",
	height: Ti.UI.SIZE,
	layout: "vertical"
}

// The warning is this modal's title — it shares the titlebar with the ✕ the way
// every other modal's title does, rather than leaving the ✕ a line of its own
// with an empty band under it. The room that gives back is the room the password
// field needs.
".deleteTitlebar": {
	top: "8dp"
}

".deleteWarning": {
	left: "8%",
	width: "76%",
	height: Ti.UI.SIZE,
	color: Alloy.CFG.colors.primary,
	textAlign: Ti.UI.TEXT_ALIGNMENT_LEFT
}

".deleteText": {
	top: "12dp",
	// An explicit width (not left/right margins alone): Android otherwise
	// measures the label's height at a width it is not laid out in, wraps to
	// fewer lines, and clips.
	width: "84%",
	height: Ti.UI.SIZE,
	left: "8%",
	color: Alloy.CFG.colors.primary,
	textAlign: Ti.UI.TEXT_ALIGNMENT_LEFT,
	font: { fontFamily: "Tahoma", fontSize: "16dp" }
}

".deleteText[if=Alloy.Globals.isHighRes]": {
	font: { fontFamily: "Tahoma", fontSize: "20dp" }
}

".deleteText[if=Alloy.Globals.isXHighRes]": {
	font: { fontFamily: "Tahoma", fontSize: "28dp" }
}

// An explicit height rather than Ti.UI.SIZE: sized to its text alone the field
// is barely taller than one line of it, which reads as a box that is not meant
// to be typed in.
".deletePassword": {
	top: "12dp",
	width: "84%",
	height: "40dp",
	left: "8%",
	passwordMask: true,
	backgroundColor: Alloy.CFG.colors.white,
	borderColor: Alloy.CFG.colors.primary,
	borderWidth: "2dp",
	borderRadius: "8dp",
	color: Alloy.CFG.colors.black,
	// Every other entry field in the app gets this from the shared .textField
	// class; this one carries its own layout, so it needs it directly. Without
	// it Android's landscape IME goes to "extract mode" and replaces the whole
	// app with its own full-screen editor.
	fullscreen: false,
	font: { fontFamily: "Tahoma", fontSize: "18dp" }
}

".deleteButtons": {
	top: "20dp",
	bottom: "16dp",
	width: Ti.UI.SIZE,
	height: Ti.UI.SIZE
}

"#cancelButton": {
	right: "12dp",
	color: Alloy.CFG.colors.primary,
	backgroundColor: Alloy.CFG.colors.white,
	borderColor: Alloy.CFG.colors.primary,
	borderWidth: "1dp"
}

// The outline, held a button's width away from the button itself. Two reds meeting
// edge to edge read as one muddy border, so white sits between them — which takes
// a frame, since a view has only the one border to give.
// The colours are the view-model's: whether the button can be pressed is state,
// and neither platform renders a stylesheet's account of it correctly (iOS
// ignores backgroundDisabledColor; Android greys the body but keeps the outline).
// The frame carries the width the button used to, because the button can no
// longer carry one: an explicit width alongside left and right margins is the
// over-constraint that makes a Classic parent grow instead of inset its child.
// So the frame is the sized one and the button fills it, less the gap.
".deleteButtonFrame": {
	left: "12dp",
	// Wider than the shared action button: "DELETE ACCOUNT" is a long label and
	// gets elided to nonsense at the standard width.
	width: "200dp",
	height: Ti.UI.SIZE,
	layout: "vertical",
	backgroundColor: Alloy.CFG.colors.white,
	borderColor: Alloy.CFG.colors.failure,
	borderWidth: "2dp",
	borderRadius: "8dp"
}

".deleteButtonFrame[if=Alloy.Globals.isHighRes]": {
	width: "240dp"
}

".deleteButtonFrame[if=Alloy.Globals.isXHighRes]": {
	width: "330dp"
}

"#deleteButton": {
	top: "3dp",
	bottom: "3dp",
	left: "3dp",
	right: "3dp",
	width: Ti.UI.FILL,
	color: Alloy.CFG.colors.white,
	backgroundColor: Alloy.CFG.colors.error,
	borderWidth: 0
}

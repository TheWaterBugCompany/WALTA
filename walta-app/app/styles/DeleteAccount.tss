".deleteWindow": {
	width: "72%",
	height: Ti.UI.SIZE,
	layout: "vertical"
}

".deleteText": {
	top: "12dp",
	// An explicit width (not left/right margins alone): Android otherwise
	// measures the label's height at a width it is not laid out in, wraps to
	// fewer lines, and clips.
	width: "84%",
	height: Ti.UI.SIZE,
	left: "8%",
	color: Alloy.CFG.colors.primary,
	textAlign: Ti.UI.TEXT_ALIGNMENT_LEFT,
	font: { fontFamily: "Tahoma", fontSize: "16dp" }
}

".deleteText[if=Alloy.Globals.isHighRes]": {
	font: { fontFamily: "Tahoma", fontSize: "20dp" }
}

".deleteText[if=Alloy.Globals.isXHighRes]": {
	font: { fontFamily: "Tahoma", fontSize: "28dp" }
}

".deletePassword": {
	top: "12dp",
	width: "84%",
	height: Ti.UI.SIZE,
	left: "8%",
	passwordMask: true,
	backgroundColor: Alloy.CFG.colors.white,
	borderColor: Alloy.CFG.colors.primary,
	borderWidth: "2dp",
	borderRadius: "8dp",
	color: Alloy.CFG.colors.black,
	// Every other entry field in the app gets this from the shared .textField
	// class; this one carries its own layout, so it needs it directly. Without
	// it Android's landscape IME goes to "extract mode" and replaces the whole
	// app with its own full-screen editor.
	fullscreen: false,
	font: { fontFamily: "Tahoma", fontSize: "18dp" }
}

".deleteButtons": {
	top: "20dp",
	bottom: "16dp",
	width: Ti.UI.SIZE,
	height: Ti.UI.SIZE
}

"#cancelButton": {
	right: "12dp",
	color: Alloy.CFG.colors.primary,
	backgroundColor: Alloy.CFG.colors.white,
	borderColor: Alloy.CFG.colors.primary,
	borderWidth: "1dp"
}

// Coloured like the warning it is. Newer Android keeps a disabled button on its
// enabled backgroundColor unless a disabled background is set explicitly — so
// without this, "no password typed yet" would still read as ready to go.
"#deleteButton": {
	left: "12dp",
	// Wider than the shared action button: "DELETE ACCOUNT" is a long label and
	// gets elided to nonsense at the standard width.
	width: "190dp",
	color: Alloy.CFG.colors.white,
	backgroundColor: Alloy.CFG.colors.error,
	backgroundDisabledColor: Alloy.CFG.colors.disabled,
	borderColor: Alloy.CFG.colors.failure,
	borderWidth: "2dp"
}

"#deleteButton[if=Alloy.Globals.isHighRes]": {
	width: "230dp"
}

"#deleteButton[if=Alloy.Globals.isXHighRes]": {
	width: "320dp"
}

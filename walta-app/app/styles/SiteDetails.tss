
"#content": {
    horizontalWrap: false,
    width: Ti.UI.FILL,
    height: Ti.UI.FILL
}

// WB-100: do not combine `width` with `right` here — Ti Classic
// expands #content to satisfy both, and the keyboard-tweak ScrollView
// wrap (lib/ui/Layout.js) then rubber-bands on horizontal drag.
"#right" : {
    left: "2%",
    width: "40%",
    top: "5%"
}

"#left" : {
    left: "2%",
    width: "55%",
    top: "5%"
}

"#right[if=Alloy.Globals.isHighRes]" : {
    width: "45%"
}

"#left[if=Alloy.Globals.isHighRes]" : {
    width: "50%"
}


"#left[if=Alloy.Globals.isXHighRes]" : {
    width: "50%"
}

"#right[if=Alloy.Globals.isXHighRes]" : {
    width: "50%"
}

"#photoSelectWrapper" : {
    left: "2%",
    height: "70%"
}

"#nextWrapper": {
    bottom: "3%",
    right: "1%"
}

// Definite sizes both ways: a Ti.UI.SIZE group whose field carries percentage
// margins resolves against a parent derived from the field, and Ti Classic
// settles that circle differently either side of the keyboard ScrollView wrap.
".fieldGroup": {
    width: Ti.UI.FILL,
    height: Ti.UI.SIZE
}

".textField": {
    top: "2dp",
    bottom: "2dp",
    height: "40dp"
}

".textField[if=Alloy.Globals.isXHighRes]": {
    height: "80dp"
}

".labelText": {
    left: "1%",
    bottom: "1%",
    textAlign: Ti.UI.TEXT_ALIGNMENT_LEFT
}
".errorWrap": {
    borderWidth: "1dp",
    borderRadius: 10,
    bottom: "1%"
}
".errorWrap[if=Alloy.Globals.isHighRes]": {
    borderRadius: 25,
    borderWidth: "6dp",
}
".errorWrap[if=Alloy.Globals.isXHighRes]": {
    borderRadius: 50,
    borderWidth: "5px"
}
".tabs" : {
    width: "300dp",
    height: "40dp",
    bottom: "4dp",
    borderRadius: 6,
	borderColor: "#b4d2d9",
	selectedButtonColor: Alloy.CFG.colors.primary,
	unselectedButtonColor: Alloy.CFG.colors.white, 
	selectedButtonTextColor: Alloy.CFG.colors.white,
	unselectedButtonTextColor: Alloy.CFG.colors.primary,
	withDividers: true
}

".tabs[if=Alloy.Globals.isHighRes]": {
    width: "300dp",
    height: "40dp",
}

".tabs[if=Alloy.Globals.isXHighRes]": {
    width: "600dp",
    height: "70dp",
}

"#locationIndicator": {
    horizontalWrap: false,
    height: "50%",
    width: "75%"
}

"#locationStatus": {
    horizontalWrap: false,
    top: "2dp",
    left: "2dp"
}

"#locationIndicatorIcon": {
    image: "/images/location-icon.png",
    height: "32dp",
    width: "20dp",
    right: "4dp"
}
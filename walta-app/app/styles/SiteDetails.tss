
"#content": {
    horizontalWrap: false,
    width: Ti.UI.FILL,
    height: Ti.UI.FILL
}

// WB-100: do not combine `width` with `right` here — Ti Classic
// expands #content to satisfy both, and the keyboard-tweak ScrollView
// wrap (lib/ui/Layout.js) then rubber-bands on horizontal drag.
"#right" : {
    left: "2%",
    width: "40%",
    top: "5%"
}

"#left" : {
    left: "2%",
    width: "55%",
    top: "5%"
}

"#right[if=Alloy.Globals.isHighRes]" : {
    width: "45%"
}

"#left[if=Alloy.Globals.isHighRes]" : {
    width: "50%"
}


// Each column carries a 2% gap before it and nothing after the last one, so the
// trailing margin is whatever the widths leave over: they have to come to 96%
// for the gutter past the photo selector to match the three before it. At 50/50
// they came to 104% and the selector was pushed off the right of the screen; at
// 48/48 it reached the edge exactly and had no margin at all.
"#left[if=Alloy.Globals.isXHighRes]" : {
    width: "48%"
}

// The 2% comes out of this column rather than the other one: the left holds the
// tab controls, which are a fixed dp wide and drop buttons they cannot place.
"#right[if=Alloy.Globals.isXHighRes]" : {
    width: "46%"
}

"#photoSelectWrapper" : {
    left: "2%",
    height: "70%"
}

"#nextWrapper": {
    bottom: "3%",
    right: "1%"
}

// Definite sizes both ways: a Ti.UI.SIZE group whose field carries percentage
// margins resolves against a parent derived from the field, and Ti Classic
// settles that circle differently either side of the keyboard ScrollView wrap.
".fieldGroup": {
    width: Ti.UI.FILL,
    height: Ti.UI.SIZE
}

".textField": {
    top: "2dp",
    bottom: "2dp",
    height: "40dp"
}

".textField[if=Alloy.Globals.isXHighRes]": {
    height: "80dp"
}

".labelText": {
    left: "1%",
    bottom: "1%",
    textAlign: Ti.UI.TEXT_ALIGNMENT_LEFT
}
".errorWrap": {
    borderWidth: "1dp",
    borderRadius: 10,
    bottom: "1%"
}
".errorWrap[if=Alloy.Globals.isHighRes]": {
    borderRadius: 25,
    borderWidth: "6dp",
}
// In dp, because a bare number is points on iOS and raw pixels on Android: at
// 50 the iPad drew a 50dp curve into a 37dp half-height and flared the ends out
// to points, while the Android tablet drew the 25dp this asks for.
".errorWrap[if=Alloy.Globals.isXHighRes]": {
    borderRadius: "25dp",
    borderWidth: "5px"
}
".tabs" : {
    width: "300dp",
    height: "40dp",
    bottom: "4dp",
    // The error wrapper rounds and masks this control, so a radius of its own that
    // disagrees is carved away at both ends: the border dissolves into a tick and
    // the selected button is left bulging past it. Concentric means the wrapper's
    // radius less the wrapper's border, and it has to track every bucket the
    // wrapper scales through.
    borderRadius: 9,
	borderColor: "#b4d2d9",
	selectedButtonColor: Alloy.CFG.colors.primary,
	unselectedButtonColor: Alloy.CFG.colors.white, 
	selectedButtonTextColor: Alloy.CFG.colors.white,
	unselectedButtonTextColor: Alloy.CFG.colors.primary,
	withDividers: true
}

".tabs[if=Alloy.Globals.isHighRes]": {
    width: "300dp",
    height: "40dp",
    borderRadius: 19,
}

// In dp, and narrow enough for the column it sits in on the smallest tablet
// we render at: at 600dp it measured 605 and lost the end of "Detailed" and
// "Lake/Dam" off the side. Not a percentage — the segmented control divides a
// dp width between its buttons and drops the ones it cannot place.
".tabs[if=Alloy.Globals.isXHighRes]": {
    width: "540dp",
    height: "70dp",
    borderRadius: "22dp",
}

"#locationIndicator": {
    horizontalWrap: false,
    height: "50%",
    width: "75%"
}

"#locationStatus": {
    horizontalWrap: false,
    top: "2dp",
    left: "2dp"
}

"#locationIndicatorIcon": {
    image: "/images/location-icon.png",
    height: "32dp",
    width: "20dp",
    right: "4dp"
}
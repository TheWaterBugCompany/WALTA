
// The incorrect-assessment notice: a slightly translucent white rounded card
// near the top, primary teal text. It hugs its text (width SIZE) so the
// horizontal padding matches the vertical. Starts transparent (the controller
// fades it in on a wrong assess).
"#incorrectNotice": {
  top: "10dp",
  width: Ti.UI.SIZE,
  height: Ti.UI.SIZE,
  layout: "vertical",
  backgroundColor: "#E6FFFFFF",
  borderRadius: "12dp",
  opacity: 0,
  zIndex: 100,
  viewShadowColor: "#40000000",
  viewShadowRadius: "6dp",
  viewShadowOffset: { x: 0, y: 2 }
}

"#incorrectNoticeLabel": {
  top: "14dp",
  bottom: "14dp",
  left: "14dp",
  right: "14dp",
  width: Ti.UI.SIZE,
  height: Ti.UI.SIZE,
  color: Alloy.CFG.colors.primary,
  textAlign: Ti.UI.TEXT_ALIGNMENT_CENTER,
  font: { fontFamily: "Tahoma", fontSize: "15dp" }
}

"#incorrectNoticeLabel[if=Alloy.Globals.isHighRes]": {
  font: { fontFamily: "Tahoma", fontSize: "19dp" }
}

"#incorrectNoticeLabel[if=Alloy.Globals.isXHighRes]": {
  font: { fontFamily: "Tahoma", fontSize: "26dp" }
}

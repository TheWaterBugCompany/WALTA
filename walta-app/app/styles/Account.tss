"#content": {
	backgroundColor: Alloy.CFG.colors.white,
	layout: "vertical"
}

// The account's details on the left, the two things you can do to it on the
// right — so neither reads as a caption for the other.
"#accountHeader": {
	top: "4%",
	width: "92%",
	height: Ti.UI.SIZE
}

"#accountFields": {
	left: "0dp",
	width: "62%",
	height: Ti.UI.SIZE
}

".fieldRow": {
	width: Ti.UI.FILL,
	height: Ti.UI.SIZE,
	top: "6dp",
	bottom: "6dp"
}

".fieldLabel": {
	left: "0dp",
	width: "18%",
	height: Ti.UI.SIZE,
	color: Alloy.CFG.colors.primary,
	textAlign: Ti.UI.TEXT_ALIGNMENT_RIGHT,
	font: { fontFamily: "Tahoma", fontWeight: "bold", fontSize: "15dp" }
}

// Unboxed, and the same colour as every other line on the page: these are
// shown, not edited, and a border around them reads as a text field inviting a
// tap that does nothing.
".fieldValue": {
	left: "22%",
	right: "0dp",
	width: Ti.UI.FILL,
	height: Ti.UI.SIZE,
	color: Alloy.CFG.colors.primary,
	textAlign: Ti.UI.TEXT_ALIGNMENT_LEFT,
	font: { fontFamily: "Tahoma", fontWeight: "bold", fontSize: "15dp" }
}

"#accountActions": {
	right: "0dp",
	width: "34%",
	height: Ti.UI.SIZE
}

".accountButton": {
	width: Ti.UI.FILL,
	height: Ti.UI.SIZE,
	top: "6dp",
	bottom: "6dp",
	borderRadius: "6dp",
	font: { fontFamily: "Tahoma", fontWeight: "bold", fontSize: "15dp" }
}

".logOutButton": {
	color: Alloy.CFG.colors.primary,
	backgroundColor: Alloy.CFG.colors.primaryLight
}

// Deleting an account cannot be undone, so it is coloured like the warning it
// is rather than like the button above it.
".deleteButton": {
	color: Alloy.CFG.colors.white,
	backgroundColor: Alloy.CFG.colors.error,
	borderColor: Alloy.CFG.colors.failure,
	borderWidth: "2dp"
}

".beltsHeading": {
	left: "4%",
	top: "4%",
	width: "92%",
	height: Ti.UI.SIZE,
	color: Alloy.CFG.colors.primary,
	textAlign: Ti.UI.TEXT_ALIGNMENT_LEFT,
	font: { fontFamily: "Tahoma", fontSize: "22dp" }
}

// Reads as body text under the heading rather than as a second heading: it
// stands in for the grid, so it sits where the first row of belts would.
".noBeltsNotice": {
	left: "4%",
	top: "3%",
	width: "92%",
	height: Ti.UI.SIZE,
	color: Alloy.CFG.colors.primary,
	textAlign: Ti.UI.TEXT_ALIGNMENT_LEFT,
	font: { fontFamily: "Tahoma", fontSize: "15dp" }
}

".noBeltsNotice[if=Alloy.Globals.isHighRes]": {
	font: { fontFamily: "Tahoma", fontSize: "19dp" }
}

".noBeltsNotice[if=Alloy.Globals.isXHighRes]": {
	font: { fontFamily: "Tahoma", fontSize: "28dp" }
}

// The belts earned, three to a row and wrapping onto the next — lowest first,
// so the grid reads in the order they were won. Each belt sizes itself (the
// view-model says how wide and tall), so the grid only has to hold them.
"#beltGrid": {
	top: "2%",
	width: "92%",
	height: Ti.UI.FILL,
	horizontalWrap: true
}

".fieldLabel[if=Alloy.Globals.isHighRes]": {
	font: { fontFamily: "Tahoma", fontWeight: "bold", fontSize: "19dp" }
}

".fieldValue[if=Alloy.Globals.isHighRes]": {
	font: { fontFamily: "Tahoma", fontWeight: "bold", fontSize: "19dp" }
}

".accountButton[if=Alloy.Globals.isHighRes]": {
	font: { fontFamily: "Tahoma", fontWeight: "bold", fontSize: "19dp" }
}

".beltsHeading[if=Alloy.Globals.isHighRes]": {
	font: { fontFamily: "Tahoma", fontSize: "28dp" }
}

".fieldLabel[if=Alloy.Globals.isXHighRes]": {
	font: { fontFamily: "Tahoma", fontWeight: "bold", fontSize: "28dp" }
}

".fieldValue[if=Alloy.Globals.isXHighRes]": {
	font: { fontFamily: "Tahoma", fontWeight: "bold", fontSize: "28dp" }
}

".accountButton[if=Alloy.Globals.isXHighRes]": {
	font: { fontFamily: "Tahoma", fontWeight: "bold", fontSize: "28dp" }
}

".beltsHeading[if=Alloy.Globals.isXHighRes]": {
	font: { fontFamily: "Tahoma", fontSize: "40dp" }
}

<Alloy> 
	<View id="content" class="container">
			<View id="bigOptions">
				<Label id="appVersion"/>
				<View id="logInOrRegister">
					<Label id="logInLabel" class="smallMenuText" text="Log In"  accessibilityLabel="Log In"  />
				</View>
				<View>

				</View>
				<View id="detailed">
					<View id="detailedIconWrapper">
						<ImageView id="detailedIcon" />
					</View> 
					<Label id="detailedLabel" class="bigMenuText" text="Start\nWaterbug\nSurvey"  accessibilityLabel="Waterbug Survey"/>
				</View>
			</View>
			<View id="smallOptions" layout="horizontal">
				<View id="identify" class="smallButton">
					<ImageView id="identifyIcon" class="smallButtonIcon"  />
					<Label id="identifyLabel" class="smallMenuText" text="Identify" accessibilityLabel="Identify" />
				</View>
				<View id="history" class="smallButton">
					<ImageView id="historyIcon" class="smallButtonIcon"  />
					<Label id="historyLabel" class="smallMenuText" text="Archive"  accessibilityLabel="Archive" />
				</View>
				<View id="gallery" class="smallButton">
					<ImageView id="galleryIcon" class="smallButtonIcon"  />
					<Label id="galleryLabel" class="smallMenuText" text="Photo Gallery" accessibilityLabel="Photo Gallery" />
				</View>
				<View id="academy" class="smallButton">
					<ImageView id="academyIcon" class="smallButtonIcon"  />
					<Label id="academyLabel" class="smallMenuText" text="Academy"  accessibilityLabel="Academy" />
				</View>
				<View id="about" class="smallButton">
					<ImageView id="aboutIcon" class="smallButtonIcon"  />
					<Label id="aboutLabel" class="smallMenuText" text="About"  accessibilityLabel="About" />
				</View>
			</View>
	</View>
</Alloy>

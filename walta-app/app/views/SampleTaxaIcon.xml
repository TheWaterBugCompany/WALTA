<Alloy>
	<View id="SampleTaxaIcon">
		<View id="padIcon" class="padIcon">
			<ImageView id="icon"/>
			<Label id="abundance"/>
		</View>
		<Label id="numberOutline" class="cellNumberOutline"/>
		<Label id="number" class="cellNumber"/>
		<!-- Training tick/cross overlay, above the silhouette but below the tap
		     surface so it never intercepts a tap. Hidden until assessed. -->
		<ImageView id="verdict" class="verdict"/>
		<!-- Last child = topmost = the single hit target, so a tap always lands on a
		     listener-bearing view (iOS) and never double-fires. -->
		<View id="tap" class="tapSurface"/>
	</View>
</Alloy>

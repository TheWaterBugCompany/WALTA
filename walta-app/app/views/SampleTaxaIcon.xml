<Alloy>
	<View id="SampleTaxaIcon">
		<View id="padIcon" class="padIcon">
			<ImageView id="icon"/>
			<Label id="abundance"/>
		</View>
		<!-- The add icon: a small centred image (shown only on a plus cell), drawn
		     beneath the tap surface so the tap still lands on the hit target. -->
		<ImageView id="plus" class="plusIcon"/>
		<!-- Last child = topmost = the single hit target for every cell kind, so a
		     tap always lands on a listener-bearing view (iOS) and never double-fires. -->
		<View id="tap" class="tapSurface"/>
	</View>
</Alloy>

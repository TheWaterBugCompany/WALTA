<Alloy>
	<View class="overlay">
		<View id="academyWindow" class="window academyWindow" layout="vertical">
			<View class="titlebar">
				<Label id="academyTitle" class="titleText" accessibilityLabel="Academy">Academy</Label>
				<Require id="closeButton" src="CloseButton"/>
			</View>
			<Label id="currentMessage" class="beltCaption" accessibilityLabel="academy_current_belt"/>
			<View id="currentBelt" class="academyBelt"/>
			<Label id="nextMessage" class="beltCaption" accessibilityLabel="academy_next_belt"/>
			<View id="nextBelt" class="academyBelt"/>
			<Label id="introMessage" class="academyIntro" accessibilityLabel="academy_intro"/>
			<View id="buttonRow" class="academyButtons" layout="horizontal">
				<Button id="cancelButton" class="actionButton" accessibilityLabel="academy_close">Close</Button>
				<Button id="startButton" class="actionButton startButton" accessibilityLabel="academy_start"/>
			</View>
		</View>
	</View>
</Alloy>

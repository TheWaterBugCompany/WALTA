<Alloy>
	<View id="content">
		<View id="surveyDate">
			<Label id="surveyDateTitle" class="labelText" text="Survey date:"/>
			<View id="surveyDateField" onClick="onSurveyDateClick" accessibilityLabel="Survey date">
				<Label id="surveyDateValue" class="labelText"/>
				<ImageView id="surveyDateIcon" image="/images/calendar-icon.png"/>
			</View>
		</View>
		<View id="partial">
			<Switch id="partialToggle" class="checkbox" accessibilityLabel="Partial Submission" onChange="onPartialChange"/>
			<Label id="partialLabel" class="labelText optionLabel" text="This survey is a complete river health assessment (leave unselected if this just for your personal waterbug collection)."/>
		</View>
		<View id="notes">
			<Label id="notesLabel" class="labelText" text="Enter any notes relating to this survey:"/>
			<TextArea id="notesTextField" accessibilityLabel="Notes" onChange="onNotesChange"/>
		</View>
	</View>
</Alloy>

<Alloy>
	<View class="overlay">
		<View id="pickerWindow" class="window">
			<View id="pickerCard" layout="vertical">
				<View id="titleBar" class="titlebar">
					<Require id="closeButton" src="CloseButton"/>
				</View>
				<View id="pickerFrame">
					<Picker id="datePicker"/>
				</View>
				<View id="buttonBar">
					<Button id="doneButton" class="actionButton" title="  Done  " onClick="doneClick"/>
				</View>
			</View>
		</View>
	</View>
</Alloy>

<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:android="http://schemas.android.com/apk/res/android">
    <style name="Theme.WaterbugApp.Checkbox" parent="Widget.AppCompat.CompoundButton.CheckBox">
        <item name="buttonTint">#26849c</item>
    </style>
    <style name="Widget.WaterbugApp.Button" parent="Widget.AppCompat.Button">
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="TextAppearance.WaterbugApp.Button" parent="TextAppearance.AppCompat.Button">
        <item name="android:textAllCaps">false</item>
    </style>
    <!-- Bridge base: provides the Material Components attributes that
         showDatePickerDialog's MaterialDatePicker needs, while keeping AppCompat
         widget rendering so the app's custom button backgroundColors still apply
         (a full Material base swaps in MaterialButton, which ignores Ti's
         backgroundColor). materialCalendarTheme isn't defined by Bridge, so it's
         set explicitly; colorPrimary brands the picker's landscape header. -->
    <style name="Theme.WaterbugApp" parent="Theme.MaterialComponents.Light.Bridge">
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorPrimary">#26849c</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="materialCalendarTheme">@style/ThemeOverlay.MaterialComponents.MaterialCalendar</item>
        <item name="android:windowFullscreen">true</item>

        <item name="checkboxStyle">@style/Theme.WaterbugApp.Checkbox</item>

        <item name="android:buttonStyle">@style/Widget.WaterbugApp.Button</item>
        <item name="buttonStyle">@style/Widget.WaterbugApp.Button</item>
        <item name="textAppearanceButton">@style/TextAppearance.WaterbugApp.Button</item>

        <item name="android:windowBackground">@drawable/background</item>
		<item name="android:windowActionBar">false</item>
		<item name="android:windowNoTitle">true</item>

		<!-- AppCompat Compatibility -->
		<item name="windowActionBar">false</item>
		<item name="windowNoTitle">true</item>

    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:android="http://schemas.android.com/apk/res/android">
    <style name="Theme.WaterbugApp.Checkbox" parent="Widget.AppCompat.CompoundButton.CheckBox">
        <item name="buttonTint">#26849c</item>
    </style>
    <style name="Widget.WaterbugApp.Button" parent="Widget.AppCompat.Button">
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="TextAppearance.WaterbugApp.Button" parent="TextAppearance.AppCompat.Button">
        <item name="android:textAllCaps">false</item>
    </style>
    <!-- Titanium 10+ dropped AppCompat support and renders native Material
         widgets, so the app theme inherits from a full Theme.MaterialComponents
         base. This also defines materialCalendarTheme (which showDatePickerDialog's
         MaterialDatePicker requires) and a default Material textInputStyle. -->
    <style name="Theme.WaterbugApp" parent="Theme.MaterialComponents.Light">
        <item name="colorSurface">#FFFFFF</item>
        <!-- Brand colour drives Material widgets (incl. the date picker header,
             otherwise an unstyled grey panel beside the calendar in landscape). -->
        <item name="colorPrimary">#26849c</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="android:windowFullscreen">true</item>

        <item name="checkboxStyle">@style/Theme.WaterbugApp.Checkbox</item>

        <item name="android:buttonStyle">@style/Widget.WaterbugApp.Button</item>
        <item name="buttonStyle">@style/Widget.WaterbugApp.Button</item>
        <item name="textAppearanceButton">@style/TextAppearance.WaterbugApp.Button</item>

        <item name="android:windowBackground">@drawable/background</item>
		<item name="android:windowActionBar">false</item>
		<item name="android:windowNoTitle">true</item>

		<!-- AppCompat Compatibility -->
		<item name="windowActionBar">false</item>
		<item name="windowNoTitle">true</item>

    </style>
</resources>

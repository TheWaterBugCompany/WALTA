// This flag is generated by the module build, do not change it.
TI_MODULE_VERSION=2.0.0

// BugfenderSDK.framework lives at platform/iphone/BugfenderSDK.framework.
// The SDK's gatherResources() walker copies contents of platform/iphone/ to
// $(SRCROOT) (build/iphone/) during the build, so we point the search path
// there and explicitly link the framework.
FRAMEWORK_SEARCH_PATHS = $(inherited) "$(SRCROOT)"
OTHER_LDFLAGS = $(inherited) -framework BugfenderSDK

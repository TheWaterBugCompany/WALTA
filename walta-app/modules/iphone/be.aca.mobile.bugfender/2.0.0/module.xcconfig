// This flag is generated by the module build, do not change it.
TI_MODULE_VERSION=2.0.0

// BugfenderSDK.framework lives at platform/iphone/BugfenderSDK.framework.
// Titanium's frameworks.js only scans platform/ (not platform/iphone/), so it
// won't auto-detect it. The SDK's gatherResources() walker copies the framework
// to $(SRCROOT) (build/iphone/) during the build, so we point the search path
// there and explicitly link the framework.
//
// For simulator builds, stripsimincompatiblemodules removes this module before
// module.xcconfig is generated, so these settings are automatically excluded.
FRAMEWORK_SEARCH_PATHS = $(inherited) "$(SRCROOT)"
OTHER_LDFLAGS = $(inherited) -framework BugfenderSDK
